{
	"name": "my-first-worker",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "sh ./scripts/with-env.sh wrangler deploy",
		"dev": "sh ./scripts/ensure-dev-vars.sh && npm run db:migrate:local && sh ./scripts/with-env.sh wrangler dev",
		"start": "sh ./scripts/ensure-dev-vars.sh && sh ./scripts/with-env.sh wrangler dev",
		"test": "jest --coverage",
		"cf-typegen": "sh ./scripts/with-env.sh wrangler types",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "sh ./scripts/ensure-dev-vars.sh && sh ./scripts/with-env.sh wrangler d1 migrations apply my-db-name --local",
		"db:migrate:remote": "sh ./scripts/with-env.sh wrangler d1 migrations apply my-db-name --remote",
		"db:list-duplicate-employees:local": "sh ./scripts/cleanup-duplicate-employees.sh --list --local",
		"db:list-duplicate-employees:remote": "sh ./scripts/cleanup-duplicate-employees.sh --list --remote",
		"cf:whoami": "sh ./scripts/with-env.sh wrangler whoami"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.12.4",
		"@types/jest": "^30.0.0",
		"@types/node": "^25.4.0",
		"drizzle-kit": "^0.31.9",
		"typescript": "^5.9.3",
		"vitest": "~3.2.0",
		"wrangler": "^4.71.0"
	},
	"dependencies": {
		"@clerk/backend": "^3.2.0",
		"aws4fetch": "^1.0.20",
		"drizzle-orm": "^0.45.1",
		"graphql": "^16.13.1",
		"graphql-yoga": "^5.18.1",
		"hono": "^4.12.6",
		"jest": "^30.3.0",
		"pdf-lib": "^1.17.1",
		"ts-jest": "^29.4.6"
	},
	"main": "index.js",
	"directories": {
		"test": "test"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"description": ""
}
