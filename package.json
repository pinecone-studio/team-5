{
  "name": "team-5",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "prepare": "husky",
    "commit": "cz",
    "setup:local": "sh ./scripts/setup-local.sh",
    "doctor": "sh ./scripts/doctor.sh",
    "service:dev": "npm run dev --prefix service",
    "service:test": "npm test --prefix service",
    "service:lint": "npm run lint --prefix service || echo \"(no service lint script)\"",
    "service:build": "npm run build --prefix service || echo \"(no service build script)\"",
    "web:dev": "npm run dev --prefix web",
    "web:test": "npm test --prefix web",
    "web:lint": "npm run lint --prefix web",
    "web:build": "npm run build --prefix web",
    "lint": "npm run service:lint && npm run web:lint",
    "test": "npm run service:test && npm run web:test",
    "build": "npm run service:build && npm run web:build"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "commitizen": "^4.3.1",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7"
  }
}
